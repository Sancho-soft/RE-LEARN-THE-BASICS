press_sfx = &"toggle"

[node name="PageFooter" type="HBoxContainer" parent="MarginContainer/MainVBox"]
layout_mode = 2
alignment = 1

[node name="PagePill" type="PanelContainer" parent="MarginContainer/MainVBox/PageFooter"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_page_pill")

[node name="PageLabel" type="Label" parent="MarginContainer/MainVBox/PageFooter/PagePill"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 19
text = "Activities 1–4   •   Page 1 of 2"
horizontal_alignment = 1
vertical_alignment = 1
